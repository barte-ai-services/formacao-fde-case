# Copie este arquivo para .env (cp .env.example .env) e preencha os valores.
# O arquivo .env nunca vai para o Git: ele já está no .gitignore.

# Chave da API da Anthropic, usada pelo agente.
# Os organizadores vão passar as orientações de como obter a chave.
ANTHROPIC_API_KEY=

# Modelo que o agente usa. Deixe como está, a não ser que os organizadores digam outro.
AGENT_MODEL=claude-sonnet-5-5
